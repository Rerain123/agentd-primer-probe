    "primer_length_nt": {"minimum": 18, "maximum": 28, "default_optimum": 20},
    "probe_length_nt": {"minimum": 22, "maximum": 32},
    "probe_tm_relative_to_primer_mean_c": {"minimum": 8, "maximum": 10}
  },
  "hard_rules": {
    "R01": "primer_tm_50_to_65_and_pair_delta_at_most_2",
    "R02": "amplicon_length_70_to_200",
    "R03": "last_5_primer_bases_gc_at_most_2_and_no_4_consecutive_g",
    "R04": "primer_length_18_to_28",
    "R05": "probe_5_prime_not_g",
    "R06": "probe_between_primers_nonoverlap_and_each_gap_at_least_5",
    "R07": "ordinary_probe_tm_primer_mean_plus_8_to_10",
    "R08": "ordinary_probe_length_22_to_32",
    "R09": "three_prime_dimer_dg_not_less_than_minus_6_and_no_strong_self_complementarity",
    "R10": "three_prime_cross_dimer_dg_not_less_than_minus_9"
  },
  "soft_rules": {
    "low_primer_tm": {"condition": "primer_tm_below_55", "penalty_percent": 5},
    "amplicon_at_lower_boundary": {"condition": "amplicon_length_equals_70", "action": "warning_and_length_score_70_only"},
    "three_prime_risk": {"condition": "last_5_gc_zero_or_three_identical_bases", "penalty_percent": 2},
    "R11": {"condition": "hairpin_dg_less_than_minus_3", "penalty_percent": 3},
    "R12": {"condition": "non_three_prime_weak_dimer_dg_between_minus_9_and_minus_6", "penalty_percent": 3}
  },
  "scoring": {
    "conservation_in_score": false,
    "weights": {"thermodynamics": 0.357, "specificity": 0.357, "amplicon_features": 0.286},
    "penalty_method": "additive",
    "probe_relative_tm_score": {"minimum_delta_c": 8, "maximum_delta_c": 10, "score": 100},
    "amplicon_length_score": {
      "70": 70,
      "71_to_150": 100,
      "151_to_200": 70
    }
  },
  "allowed_rule_statuses": ["PASS", "WARNING", "FAIL", "NOT_EVALUATED", "NOT_APPLICABLE"],
