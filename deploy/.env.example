AGENTD_IMAGE_TAG=1.2.13
AGENTD_BIND_ADDRESS=127.0.0.1
AGENTD_PORT=8020
AGENTD_CPUS=4.0
AGENTD_MEMORY_LIMIT=8g
AGENTD_BLASTDB_DIR=./server-data/blastdb
AGENTD_SEQUENCE_DATA_DIR=./server-data/sequences
AGENTD_REQUIRE_DATABASES=false
MCP_AUTH_REQUIRED=true
MCP_JWT_ALGORITHM=HS256
MCP_JWT_REQUIRE_EXP=true
MCP_PUBLIC_WF01_ARTIFACTS=true
MCP_MAX_TOOL_RESULT_BYTES=65536
MCP_WF02_SYNC_WAIT_SECONDS=235
WF02_BACKGROUND_WORKERS=1
MCP_PUBLIC_BASE_URL=https://oligosmith.ne.scqcyz.cn
WF02_ATTACHMENT_URL_TTL_SECONDS=86400
MCP_ALLOWED_HOSTS=oligosmith.ne.scqcyz.cn,127.0.0.1:8000,127.0.0.1:*
MCP_ALLOWED_ORIGINS=https://oligosmith.ne.scqcyz.cn
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
HIMAT_FILE_DOWNLOAD_BASE_URL=https://himat.ws.scqcyz.cn/api/files/download
HIMAT_FILE_DOWNLOAD_TIMEOUT_SECONDS=300
AGENTD_INPUT_FILE_MAX_BYTES=1073741824

# P5 使用 NCBI Entrez 实时获取默认管家基因 RefSeq 与同物种同源序列。
# 邮箱用于遵循 NCBI E-utilities 联系信息规范；API Key 可留空。
NCBI_ENTREZ_EMAIL=
NCBI_ENTREZ_API_KEY=

# 当本地 cross/nt BLAST 库未就绪时，用独立 NCBI BLAST MCP 完成背景特异性检查。
# Linux Docker 通过 docker-compose.yml 内的 host-gateway 访问宿主机 8090 端口。
BLAST_SEARCH_SERVICE_URL=http://host.docker.internal:8090
BLAST_SEARCH_TIMEOUT_SECONDS=360
BLAST_SEARCH_MAX_SEQS=100

# 生产上线前由 RustFS 管理员创建仅能读写 wens/data/* 的专用账号，
# 填入 AK/SK 后再把 RUSTFS_ENABLED 改为 true。不要使用 RustFS 管理员密钥。
RUSTFS_ENABLED=false
RUSTFS_ENDPOINT_URL=https://rustfs.ne.scqcyz.cn
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_BUCKET=wens
RUSTFS_REGION=us-east-1
RUSTFS_OBJECT_PREFIX=data
RUSTFS_PUBLIC_BASE_URL=https://rustfs.ne.scqcyz.cn
RUSTFS_VERIFY_TLS=true
RUSTFS_CONNECT_TIMEOUT_SECONDS=5
RUSTFS_READ_TIMEOUT_SECONDS=30
