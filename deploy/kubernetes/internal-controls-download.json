{
  "metadata": {
    "namespace": "him-ws",
    "name": "oligosmith-internal-download-r07"
  },
  "kind": "Job",
  "apiVersion": "batch/v1",
  "spec": {
    "template": {
      "spec": {
        "volumes": [
          {
            "persistentVolumeClaim": {
              "claimName": "oligosmith-blast-hosts"
            },
            "name": "data"
          },
          {
            "configMap": {
              "name": "oligosmith-internal-download-r07"
            },
            "name": "scripts"
          }
        ],
        "restartPolicy": "Never",
        "securityContext": {
          "runAsGroup": 10001,
          "fsGroup": 10001,
          "runAsUser": 10001
        },
        "imagePullSecrets": [
          {
            "name": "harbor"
          }
        ],
        "automountServiceAccountToken": false,
        "containers": [
          {
            "volumeMounts": [
              {
                "mountPath": "/data",
                "name": "data"
              },
              {
                "mountPath": "/scripts",
                "readOnly": true,
                "name": "scripts"
              }
            ],
            "command": [
              "python",
              "/scripts/fetch-internal-controls.py"
            ],
            "name": "download",
            "image": "harbor-core.base.svc.cluster.local/qcyz/oligosmith@sha256:a4654140604d08a9b0d60e05a13471375a61ed8600d935a997966c8740df1eec",
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              }
            }
          }
        ],
        "nodeSelector": {
          "kubernetes.io/hostname": "k8s-a100-02"
        }
      }
    },
    "backoffLimit": 0,
    "activeDeadlineSeconds": 7200
  }
}
