{
  "metadata": {
    "namespace": "him-ws",
    "name": "oligosmith-nt-summary-r06"
  },
  "kind": "Job",
  "apiVersion": "batch/v1",
  "spec": {
    "template": {
      "spec": {
        "volumes": [
          {
            "configMap": {
              "name": "oligosmith-nt-summary-r06"
            },
            "name": "scripts"
          },
          {
            "persistentVolumeClaim": {
              "claimName": "oligosmith-blast-hosts",
              "readOnly": true
            },
            "name": "evidence"
          }
        ],
        "restartPolicy": "Never",
