{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wens.example/schemas/wf01-scientific-artifact-v1.json",
  "title": "WF-01 科学工件",
  "description": "在 WF-01 某个科学处理阶段完成后捕获的不可变专家级原始输出。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "batchId",
    "targetId",
    "stage",
    "tools",
    "createdAt",
    "dataScope",
    "rawData"
  ],
  "properties": {
    "schemaVersion": {"const": "wf01-scientific-artifact-v1"},
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "batchId": {"type": "string", "minLength": 1},
    "targetId": {"type": ["string", "null"]},
    "stage": {"enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"]},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "dataScope": {"const": "RAW_SCIENTIFIC_STAGE_OUTPUT"},
    "rawData": {}
  }
}
