{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wens.example/schemas/wf03-v01-report.json",
  "title": "WF-03 MCP 紧凑报告",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow", "job_id", "parent_job_id", "status", "next_action",
    "assay_id", "host_species", "gene_selected", "refseq_accession",
    "candidate_count", "evidence_level", "verdict", "validation_summary",
    "fallback", "warnings", "errors", "report_tool"
  ],
  "properties": {
    "workflow": {"const": "WF-03"},
    "job_id": {"type": "string", "minLength": 1},
    "parent_job_id": {"type": ["string", "null"]},
    "status": {"enum": ["SUCCEEDED", "PARTIAL", "FAILED"]},
    "next_action": {"enum": ["END", "WAIT_FOR_USER"]},
    "assay_id": {"type": "string", "minLength": 1},
    "host_species": {"type": "string", "minLength": 1},
    "gene_selected": {"type": ["string", "null"]},
    "refseq_accession": {"type": ["string", "null"]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "evidence_level": {"enum": ["in_silico_only", "blast_verified", "experimentally_validated"]},
    "verdict": {"type": ["string", "null"]},
    "validation_summary": {"type": ["object", "null"]},
    "fallback": {"type": ["object", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "report_tool": {"const": "get_wf03_report"},
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "object"}
    }
  }
}
