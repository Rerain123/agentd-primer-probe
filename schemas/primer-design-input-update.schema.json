{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wens.example/schemas/primer-design-input-update-v1.json",
  "title": "引物设计用户字段更新",
  "description": "前端表单提交时发出的最小 role=user 消息。",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "data"],
  "properties": {
    "type": {"const": "primer_design_input_update"},
    "interactionId": {
      "type": "string",
      "pattern": "^design-input-[a-f0-9]{32}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designInput": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetOrganism": {"type": "string"},
            "host": {"type": "string"},
            "coverageRequirement": {"type": "string"}
          }
        }
      }
    }
  }
}
